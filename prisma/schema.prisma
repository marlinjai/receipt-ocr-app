generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DtTable {
  id           String     @id @default(uuid())
  workspaceId  String     @map("workspace_id")
  authTenantId String?    @map("auth_tenant_id")
  name         String
  description  String?
  icon         String?
  migrated     Boolean    @default(false)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  columns      DtColumn[]
  views        DtView[]

  @@map("dt_tables")
}

model DtColumn {
  id        String   @id @default(uuid())
  tableId   String   @map("table_id")
  name      String
  type      String
  position  Int
  width     Int      @default(200)
  isPrimary Boolean  @default(false) @map("is_primary")
  config    Json?
  alignment String?
  createdAt DateTime @default(now()) @map("created_at")
  table     DtTable  @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@map("dt_columns")
}

model SelectOption {
  id       String  @id @default(uuid())
  columnId String  @map("column_id")
  name     String
  color    String?
  position Int

  @@map("select_options")
}

model DtRowSelectValue {
  id       String @id @default(uuid())
  rowId    String @map("row_id")
  columnId String @map("column_id")
  optionId String @map("option_id")

  @@unique([rowId, columnId, optionId])
  @@map("dt_row_select_values")
}

model DtRelation {
  id             String   @id @default(uuid())
  sourceRowId    String   @map("source_row_id")
  sourceColumnId String   @map("source_column_id")
  targetRowId    String   @map("target_row_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([sourceRowId, sourceColumnId, targetRowId])
  @@map("dt_relations")
}

model DtFile {
  id           String @id @default(uuid())
  rowId        String @map("row_id")
  columnId     String @map("column_id")
  fileId       String @map("file_id")
  fileUrl      String @map("file_url")
  originalName String @map("original_name")
  mimeType     String @map("mime_type")
  sizeBytes    Int?   @map("size_bytes")
  position     Int    @default(0)
  metadata     Json?

  @@map("dt_files")
}

model DtView {
  id        String   @id @default(uuid())
  tableId   String   @map("table_id")
  name      String
  type      String   @default("table")
  isDefault Boolean  @default(false) @map("is_default")
  position  Int      @default(0)
  config    Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  table     DtTable  @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@map("dt_views")
}

model DtRow {
  id        String  @id @default(uuid())
  tableId   String  @map("table_id")
  cells     Json?
  computed  Json?
  title     String? @map("_title")
  archived  Int     @default(0) @map("_archived")
  createdAt String  @map("_created_at")
  updatedAt String  @map("_updated_at")

  @@map("dt_rows")
}

// Per-user Google connection for the Sheets importer. One row per auth-brain
// user; the refresh token is stored AES-256-GCM encrypted (never in plaintext).
// The token authorizes reading the user's own Sheets (spreadsheets.readonly);
// it is unrelated to auth-brain, which governs who may use Receipts at all.
model GoogleSheetsCredential {
  id                    String   @id @default(uuid())
  authUserId            String   @unique @map("auth_user_id")
  googleEmail           String?  @map("google_email")
  refreshTokenEncrypted String   @map("refresh_token_encrypted")
  scopes                String
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("google_sheets_credentials")
}

// A saved Sheets import for one workspace (company book): which spreadsheet/tab,
// how its columns map onto the Receipts fields, and which fields form the dedup
// identity. Scoped by the auth-brain workspace UUID (the same value that
// partitions dt_tables.workspace_id), so each company's import is isolated.
model SheetImportConfig {
  id               String           @id @default(uuid())
  authWorkspaceId  String           @map("auth_workspace_id")
  authTenantId     String?          @map("auth_tenant_id")
  spreadsheetId    String           @map("spreadsheet_id")
  sheetName        String           @map("sheet_name")
  headerRow        Int              @default(1) @map("header_row")
  columnMapping    Json             @map("column_mapping")
  dedupKeyFields   Json             @map("dedup_key_fields")
  // Attach preferences, persisted by a successful attach run so the import page
  // can prefill them for returning users. Nullable: configs predate the feature.
  attachFolderId   String?          @map("attach_folder_id")
  attachFolderName String?          @map("attach_folder_name")
  sourceFileHeader String?          @map("source_file_header")
  createdByUserId  String           @map("created_by_user_id")
  lastRunAt        DateTime?        @map("last_run_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  rows             SheetImportRow[]

  @@unique([authWorkspaceId, spreadsheetId, sheetName])
  @@map("sheet_import_configs")
}

// Dedup ledger mapping an imported sheet row (by stable key) to the dt_rows row
// it produced, so a re-run upserts instead of duplicating. Kept separate from
// dt_rows to leave the generic data-table schema untouched.
model SheetImportRow {
  id        String            @id @default(uuid())
  configId  String            @map("config_id")
  dedupKey  String            @map("dedup_key")
  dtRowId   String            @map("dt_row_id")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  config    SheetImportConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([configId, dedupKey])
  @@map("sheet_import_rows")
}

// Workspace-editable per-vendor attribution %, the configurable replacement for
// the hardcoded VENDOR_BUSINESS_SHARE_DEFAULTS. `share` is 0-100. The reserved
// vendor `*` row carries the workspace default for unlisted vendors (else 100).
// "Apply to ledger" writes these onto each matching row's Business Share %.
model WorkspaceVendorAttribution {
  id              String   @id @default(uuid())
  authWorkspaceId String   @map("auth_workspace_id")
  authTenantId    String?  @map("auth_tenant_id")
  vendor          String
  share           Int
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([authWorkspaceId, vendor])
  @@map("workspace_vendor_attribution")
}

// A named, saved chart selection on the overview: time frame (preset or custom
// range), vendor/currency filters, and explicit invoice include/exclude sets,
// stored as one JSON definition per workspace. Filter-based parts stay "live"
// (new imports join automatically); id-based parts are frozen sets.
model OverviewSelection {
  id              String   @id @default(uuid())
  authWorkspaceId String   @map("auth_workspace_id")
  authTenantId    String?  @map("auth_tenant_id")
  name            String
  definition      Json
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([authWorkspaceId, name])
  @@map("overview_selections")
}

// The overview's editable notes block (reconciliation / attribution commentary),
// one per workspace.
model WorkspaceNotes {
  id              String   @id @default(uuid())
  authWorkspaceId String   @unique @map("auth_workspace_id")
  authTenantId    String?  @map("auth_tenant_id")
  body            String   @default("")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("workspace_notes")
}

// Historical ECB reference-rate cache (via api.frankfurter.dev), keyed by invoice
// date so the same currency/date pair is never fetched twice.
model FxRate {
  id        String   @id @default(uuid())
  date      String
  currency  String
  rate      Float
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@unique([date, currency])
  @@map("fx_rates")
}

// The contact list behind the business-meal register: the people who can be
// named as guests on a meal. Deliberately small and self-contained. Every read
// and write goes through the ContactStore interface (src/lib/contacts/store.ts),
// so a later suite-wide contact service can replace this table without touching
// the meal model. `companyOrRole` is an empty string rather than NULL so the
// uniqueness below actually holds (Postgres treats NULLs as distinct).
model Contact {
  id              String    @id @default(uuid())
  authWorkspaceId String    @map("auth_workspace_id")
  authTenantId    String?   @map("auth_tenant_id")
  name            String
  companyOrRole   String    @default("") @map("company_or_role")
  note            String?
  archivedAt      DateTime? @map("archived_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([authWorkspaceId, name, companyOrRole])
  @@map("contacts")
}

// One guest on one meal. `rowId` is the receipt row; it cannot be a foreign
// key because receipt rows live either in dt_rows or in a per-table physical
// table (see resolveRowTableIds), so the delete paths clean up in code.
// `displayName` / `displayCompany` are the copy that gets printed on the
// register: the register never has to ask the contact store, and an archived
// contact keeps its place on old meals.
model MealGuest {
  id              String   @id @default(uuid())
  authWorkspaceId String   @map("auth_workspace_id")
  authTenantId    String?  @map("auth_tenant_id")
  rowId           String    @map("row_id")
  // Null once the contact is erased: the printed copy is then held until retainUntil.
  contactId       String?   @map("contact_id")
  position        Int       @default(0)
  displayName     String    @map("display_name")
  displayCompany  String    @default("") @map("display_company")
  retainUntil     DateTime? @map("retain_until")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@unique([rowId, contactId])
  @@index([authWorkspaceId, rowId])
  @@index([contactId])
  @@map("meal_guests")
}

// One row per data export handed to a company (see src/lib/company-export.ts).
model CompanyExport {
  id            String   @id @default(uuid())
  authTenantId  String   @map("auth_tenant_id")
  fileCount     Int      @map("file_count")
  sha256        String
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([authTenantId])
  @@map("company_exports")
}

// Per-workspace tax facts the meal register needs. `smallBusiness` answers one
// question, "is this business a small business under section 19 of the
// value-added tax act (Kleinunternehmer)?": NULL = not answered yet (the
// register shows no amounts until it is), true = no input tax, the 70 percent
// is taken from gross; false = taken from net.
model WorkspaceTaxSettings {
  id                      String   @id @default(uuid())
  authWorkspaceId         String   @unique @map("auth_workspace_id")
  authTenantId            String?  @map("auth_tenant_id")
  smallBusiness           Boolean? @map("small_business")
  hostAddressThresholdEur Int      @default(250) @map("host_address_threshold_eur")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("workspace_tax_settings")
}

// ── Finance and tax dashboard ────────────────────────────────────────────────
//
// What a person DECIDED about how an item is treated for tax. Only decisions
// are stored; every figure (deductible amount, line totals) is computed on
// read from the receipt row, these decisions and the year's rule set
// (src/lib/tax), so it cannot go stale.

// How a vendor is treated by default: who bears its invoices (allocations, a
// JSON list of { purpose, shareBp } in basis points) and which form lines they
// go to. Entries are dated: `effectiveFrom` is an ISO day, or '' for "from the
// beginning" (a string, not a nullable date, so the uniqueness below holds).
// An item follows the latest entry on or before its own date. A changed
// treatment is a NEW entry from a date; an entry is only rewritten to correct
// a mistake in that same entry.
model TaxVendorRule {
  id                String   @id @default(uuid())
  authWorkspaceId   String   @map("auth_workspace_id")
  authTenantId      String?  @map("auth_tenant_id")
  vendorKey         String   @map("vendor_key")
  vendorLabel       String   @map("vendor_label")
  effectiveFrom     String   @default("") @map("effective_from")
  allocations       Json
  formLineKey       String?  @map("form_line_key")
  employmentLineKey String?  @map("employment_line_key")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([authWorkspaceId, vendorKey, effectiveFrom])
  @@map("tax_vendor_rules")
}

// A decision for ONE receipt row that overrides the vendor rule. `rowId` has
// no foreign key for the same reason as meal_guests.row_id; the row delete
// paths remove the decision in code.
model TaxItemDecision {
  id                String   @id @default(uuid())
  authWorkspaceId   String   @map("auth_workspace_id")
  authTenantId      String?  @map("auth_tenant_id")
  rowId             String   @unique @map("row_id")
  allocations       Json
  formLineKey       String?  @map("form_line_key")
  employmentLineKey String?  @map("employment_line_key")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([authWorkspaceId])
  @@map("tax_item_decisions")
}

// What still needs a person's eye on ONE receipt, and what a person has
// already settled about it.
//
// `flags` are the doubts the reader recorded when it read the receipt (a total
// it could not confirm, a failed classification). `checkedAt` is a person
// saying "I looked, it is right", which hides those flags until the receipt is
// read again. `distinctFrom` lists the receipts a person confirmed are NOT the
// same purchase, so a look-alike warning is settled once and does not come
// back. Facts that can be seen on the row itself (no amount, no date) are not
// stored here: they are worked out on read and end when the row is completed.
//
// `rowId` has no foreign key for the same reason as meal_guests.row_id; the
// row delete paths remove the review in code.
model ReceiptReview {
  rowId           String    @id @map("row_id")
  authWorkspaceId String    @map("auth_workspace_id")
  authTenantId    String?   @map("auth_tenant_id")
  flags           String[]  @default([])
  distinctFrom    String[]  @default([]) @map("distinct_from")
  checkedAt       DateTime? @map("checked_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([authWorkspaceId])
  @@map("receipt_reviews")
}
