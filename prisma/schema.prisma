generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DtTable {
  id           String     @id @default(uuid())
  workspaceId  String     @map("workspace_id")
  authTenantId String?    @map("auth_tenant_id")
  name         String
  description  String?
  icon         String?
  migrated     Boolean    @default(false)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  columns      DtColumn[]
  views        DtView[]

  @@map("dt_tables")
}

model DtColumn {
  id        String   @id @default(uuid())
  tableId   String   @map("table_id")
  name      String
  type      String
  position  Int
  width     Int      @default(200)
  isPrimary Boolean  @default(false) @map("is_primary")
  config    Json?
  alignment String?
  createdAt DateTime @default(now()) @map("created_at")
  table     DtTable  @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@map("dt_columns")
}

model SelectOption {
  id       String  @id @default(uuid())
  columnId String  @map("column_id")
  name     String
  color    String?
  position Int

  @@map("select_options")
}

model DtRowSelectValue {
  id       String @id @default(uuid())
  rowId    String @map("row_id")
  columnId String @map("column_id")
  optionId String @map("option_id")

  @@unique([rowId, columnId, optionId])
  @@map("dt_row_select_values")
}

model DtRelation {
  id             String   @id @default(uuid())
  sourceRowId    String   @map("source_row_id")
  sourceColumnId String   @map("source_column_id")
  targetRowId    String   @map("target_row_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([sourceRowId, sourceColumnId, targetRowId])
  @@map("dt_relations")
}

model DtFile {
  id           String @id @default(uuid())
  rowId        String @map("row_id")
  columnId     String @map("column_id")
  fileId       String @map("file_id")
  fileUrl      String @map("file_url")
  originalName String @map("original_name")
  mimeType     String @map("mime_type")
  sizeBytes    Int?   @map("size_bytes")
  position     Int    @default(0)
  metadata     Json?

  @@map("dt_files")
}

model DtView {
  id        String   @id @default(uuid())
  tableId   String   @map("table_id")
  name      String
  type      String   @default("table")
  isDefault Boolean  @default(false) @map("is_default")
  position  Int      @default(0)
  config    Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  table     DtTable  @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@map("dt_views")
}

model DtRow {
  id        String  @id @default(uuid())
  tableId   String  @map("table_id")
  cells     Json?
  computed  Json?
  title     String? @map("_title")
  archived  Int     @default(0) @map("_archived")
  createdAt String  @map("_created_at")
  updatedAt String  @map("_updated_at")

  @@map("dt_rows")
}

// Per-user Google connection for the Sheets importer. One row per auth-brain
// user; the refresh token is stored AES-256-GCM encrypted (never in plaintext).
// The token authorizes reading the user's own Sheets (spreadsheets.readonly);
// it is unrelated to auth-brain, which governs who may use Receipts at all.
model GoogleSheetsCredential {
  id                    String   @id @default(uuid())
  authUserId            String   @unique @map("auth_user_id")
  googleEmail           String?  @map("google_email")
  refreshTokenEncrypted String   @map("refresh_token_encrypted")
  scopes                String
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("google_sheets_credentials")
}

// A saved Sheets import for one workspace (company book): which spreadsheet/tab,
// how its columns map onto the Receipts fields, and which fields form the dedup
// identity. Scoped by the auth-brain workspace UUID (the same value that
// partitions dt_tables.workspace_id), so each company's import is isolated.
model SheetImportConfig {
  id               String           @id @default(uuid())
  authWorkspaceId  String           @map("auth_workspace_id")
  authTenantId     String?          @map("auth_tenant_id")
  spreadsheetId    String           @map("spreadsheet_id")
  sheetName        String           @map("sheet_name")
  headerRow        Int              @default(1) @map("header_row")
  columnMapping    Json             @map("column_mapping")
  dedupKeyFields   Json             @map("dedup_key_fields")
  // Attach preferences, persisted by a successful attach run so the import page
  // can prefill them for returning users. Nullable: configs predate the feature.
  attachFolderId   String?          @map("attach_folder_id")
  attachFolderName String?          @map("attach_folder_name")
  sourceFileHeader String?          @map("source_file_header")
  createdByUserId  String           @map("created_by_user_id")
  lastRunAt        DateTime?        @map("last_run_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  rows             SheetImportRow[]

  @@unique([authWorkspaceId, spreadsheetId, sheetName])
  @@map("sheet_import_configs")
}

// Dedup ledger mapping an imported sheet row (by stable key) to the dt_rows row
// it produced, so a re-run upserts instead of duplicating. Kept separate from
// dt_rows to leave the generic data-table schema untouched.
model SheetImportRow {
  id        String            @id @default(uuid())
  configId  String            @map("config_id")
  dedupKey  String            @map("dedup_key")
  dtRowId   String            @map("dt_row_id")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  config    SheetImportConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([configId, dedupKey])
  @@map("sheet_import_rows")
}

// Workspace-editable per-vendor attribution %, which replaced a hardcoded
// per-vendor table (removed from the code 2026-10-15). `share` is 0-100. The reserved
// vendor `*` row carries the workspace default for unlisted vendors (else 100).
// "Apply to ledger" writes these onto each matching row's Business Share %.
model WorkspaceVendorAttribution {
  id              String   @id @default(uuid())
  authWorkspaceId String   @map("auth_workspace_id")
  authTenantId    String?  @map("auth_tenant_id")
  vendor          String
  share           Int
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([authWorkspaceId, vendor])
  @@map("workspace_vendor_attribution")
}

// A classification rule a person wrote for one workspace (company): "this
// vendor is private", "a receipt mentioning X is university". Applied when a
// receipt is read (upload, retake, reread): a `vendor` rule matches the vendor
// by case-insensitive substring, a `keyword` rule the recognized text; a match
// sets the assignment ("Zuordnung") and, when given, the category. A
// `freetext` rule is never applied by the app itself: it is an instruction
// for the chat assistant. These are reading rules, not tax treatment: how a
// vendor's receipts are taxed is a TaxVendorRule. Until 2026-10-15 the rules
// lived in the browser's local storage; the app imports them once.
model ClassificationRule {
  id               String   @id @default(uuid())
  authWorkspaceId  String   @map("auth_workspace_id")
  authTenantId     String?  @map("auth_tenant_id")
  type             String
  matchValue       String   @map("match_value")
  zuordnung        String
  categoryOverride String?  @map("category_override")
  label            String   @default("")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([authWorkspaceId, type, matchValue])
  @@map("classification_rules")
}

// A named, saved chart selection on the overview: time frame (preset or custom
// range), vendor/currency filters, and explicit invoice include/exclude sets,
// stored as one JSON definition per workspace. Filter-based parts stay "live"
// (new imports join automatically); id-based parts are frozen sets.
model OverviewSelection {
  id              String   @id @default(uuid())
  authWorkspaceId String   @map("auth_workspace_id")
  authTenantId    String?  @map("auth_tenant_id")
  name            String
  definition      Json
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([authWorkspaceId, name])
  @@map("overview_selections")
}

// The overview's editable notes block (reconciliation / attribution commentary),
// one per workspace.
model WorkspaceNotes {
  id              String   @id @default(uuid())
  authWorkspaceId String   @unique @map("auth_workspace_id")
  authTenantId    String?  @map("auth_tenant_id")
  body            String   @default("")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("workspace_notes")
}

// Historical ECB reference-rate cache (via api.frankfurter.dev), keyed by invoice
// date so the same currency/date pair is never fetched twice.
model FxRate {
  id        String   @id @default(uuid())
  date      String
  currency  String
  rate      Float
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@unique([date, currency])
  @@map("fx_rates")
}

// The contacts themselves live in the suite's shared contacts database, opened
// through @marlinjai/contacts-core (src/lib/contacts). This database keeps only
// the printed copies on meals, below.
// One guest on one meal. `rowId` is the receipt row; it cannot be a foreign
// key because receipt rows live either in dt_rows or in a per-table physical
// table (see resolveRowTableIds), so the delete paths clean up in code.
// `displayName` / `displayCompany` are the copy that gets printed on the
// register: the register never has to ask the contact store, and an archived
// contact keeps its place on old meals.
model MealGuest {
  id              String    @id @default(uuid())
  authWorkspaceId String    @map("auth_workspace_id")
  authTenantId    String?   @map("auth_tenant_id")
  rowId           String    @map("row_id")
  // Null once the contact is erased: the printed copy is then held until retainUntil.
  contactId       String?   @map("contact_id")
  position        Int       @default(0)
  displayName     String    @map("display_name")
  displayCompany  String    @default("") @map("display_company")
  retainUntil     DateTime? @map("retain_until")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@unique([rowId, contactId])
  @@index([authWorkspaceId, rowId])
  @@index([contactId])
  @@map("meal_guests")
}

// One row per data export handed to a company (see src/lib/company-export.ts).
model CompanyExport {
  id             String   @id @default(uuid())
  authTenantId   String   @map("auth_tenant_id")
  fileCount      Int      @map("file_count")
  sha256         String
  // SHA-256 over the register files of this export only (see registerHash in
  // src/lib/company-export.ts). Null on exports taken before the column existed;
  // such an export never justifies removing printed guest names.
  registerSha256 String?  @map("register_sha256")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([authTenantId])
  @@map("company_exports")
}

// Per-workspace tax facts the meal register needs. `smallBusiness` answers one
// question, "is this business a small business under section 19 of the
// value-added tax act (Kleinunternehmer)?": NULL = not answered yet (the
// register shows no amounts until it is), true = no input tax, the 70 percent
// is taken from gross; false = taken from net.
model WorkspaceTaxSettings {
  id                          String   @id @default(uuid())
  authWorkspaceId             String   @unique @map("auth_workspace_id")
  authTenantId                String?  @map("auth_tenant_id")
  smallBusiness               Boolean? @map("small_business")
  hostAddressThresholdEur     Int      @default(250) @map("host_address_threshold_eur")
  // Regular value-added taxation, asked once and required before any advance
  // return period is computed: how often a return is filed ('monthly' or
  // 'quarterly') and when the tax on an invoice is owed ('issued' or 'received').
  vatFrequency                String?  @map("vat_frequency")
  vatMethod                   String?  @map("vat_method")
  // What the owner expects to receive per month from now on, for the forecast
  // of the small-business limits. NULL: the forecast uses the run rate.
  expectedMonthlyRevenueCents Int?     @map("expected_monthly_revenue_cents")
  // The federal state of residence, for the church tax rate of the income tax
  // estimate ('BE', 'BY', ...). NULL: not stated.
  federalState                String?  @map("federal_state")
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  @@map("workspace_tax_settings")
}

// ── Finance and tax dashboard ────────────────────────────────────────────────
//
// What a person DECIDED about how an item is treated for tax. Only decisions
// are stored; every figure (deductible amount, line totals) is computed on
// read from the receipt row, these decisions and the year's rule set
// (src/lib/tax), so it cannot go stale.

// How a vendor is treated by default: who bears its invoices (allocations, a
// JSON list of { purpose, shareBp } in basis points) and which form lines they
// go to. Entries are dated: `effectiveFrom` is an ISO day, or '' for "from the
// beginning" (a string, not a nullable date, so the uniqueness below holds).
// An item follows the latest entry on or before its own date. A changed
// treatment is a NEW entry from a date; an entry is only rewritten to correct
// a mistake in that same entry.
model TaxVendorRule {
  id                String   @id @default(uuid())
  authWorkspaceId   String   @map("auth_workspace_id")
  authTenantId      String?  @map("auth_tenant_id")
  vendorKey         String   @map("vendor_key")
  vendorLabel       String   @map("vendor_label")
  effectiveFrom     String   @default("") @map("effective_from")
  allocations       Json
  formLineKey       String?  @map("form_line_key")
  employmentLineKey String?  @map("employment_line_key")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([authWorkspaceId, vendorKey, effectiveFrom])
  @@map("tax_vendor_rules")
}

// The owner's statement that the buyer owes the tax on a purchase (section 13b
// of the value-added tax act): for one receipt row (`scope` 'row', `subject`
// the row id) or for a vendor from a day on (`scope` 'vendor', `subject` the
// vendor key). `rateBp` null states "not under section 13b", which lets one
// receipt leave its vendor's entry. Resolved on read like a vendor rule; the
// row delete paths remove a row entry in code (no foreign key, as for
// tax_item_decisions).
model TaxReverseCharge {
  id              String   @id @default(uuid())
  authWorkspaceId String   @map("auth_workspace_id")
  authTenantId    String?  @map("auth_tenant_id")
  scope           String
  subject         String
  label           String   @default("")
  effectiveFrom   String   @default("") @map("effective_from")
  rateBp          Int?     @map("rate_bp")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([authWorkspaceId, scope, subject, effectiveFrom], map: "tax_reverse_charges_subject_key")
  @@map("tax_reverse_charges")
}

// A decision for ONE receipt row that overrides the vendor rule. `rowId` has
// no foreign key for the same reason as meal_guests.row_id; the row delete
// paths remove the decision in code.
model TaxItemDecision {
  id                   String   @id @default(uuid())
  authWorkspaceId      String   @map("auth_workspace_id")
  authTenantId         String?  @map("auth_tenant_id")
  rowId                String   @unique @map("row_id")
  allocations          Json
  formLineKey          String?  @map("form_line_key")
  employmentLineKey    String?  @map("employment_line_key")
  // The owner's statement that a receipt on the low-value asset line holds
  // several assets, each within the limit on its own, although their sum is not.
  severalLowValueItems Boolean  @default(false) @map("several_low_value_items")
  // Why the receipt is treated this way, in the owner's words. Not a figure.
  note                 String?
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@index([authWorkspaceId])
  @@map("tax_item_decisions")
}

// What a receipt's "Zuordnung" and "Business Share %" cells held before a
// decision or a vendor rule first decided it, from then on the cells show that
// treatment (src/lib/tax/assignment-sync.ts). When neither decides the receipt
// any more, the cells get these values back, so removing a decision restores
// exactly the figures from before it. No foreign key on `rowId`, like
// tax_item_decisions; the row delete paths remove it in code.
model TaxAssignmentOrigin {
  id              String   @id @default(uuid())
  authWorkspaceId String   @map("auth_workspace_id")
  authTenantId    String?  @map("auth_tenant_id")
  rowId           String   @unique @map("row_id")
  zuordnung       String?
  sharePercent    Float?   @map("share_percent")
  // "decided": kept when a decision or a vendor rule took the cells over.
  // "private_share": the share a private receipt held before it was set to 0
  // (it plays no role while the receipt is private, and returns if it stops being).
  reason          String   @default("decided")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([authWorkspaceId])
  @@map("tax_assignment_origins")
}

// An asset: something bought for the business that is written off instead of
// being expensed like an ordinary receipt. Its COST is not stored: it is the
// sum of the receipts linked through TaxAssetPart (the purchase, shipping,
// customs), read on every computation. Its schedule and book values are
// computed on read as well (src/lib/tax/assets.ts). Dates are ISO days as
// text, like effective_from on the vendor rules.
//
// The three `opening*` columns are set together for an asset from before the
// app: its book value on 1 January of `openingYear` and the months of useful
// life left from then. The three `disposal*` columns are set together when it
// leaves the register.
model TaxAsset {
  id                     String   @id @default(uuid())
  authWorkspaceId        String   @map("auth_workspace_id")
  authTenantId           String?  @map("auth_tenant_id")
  label                  String
  kind                   String
  acquisitionDate        String?  @map("acquisition_date")
  method                 String
  usefulLifeMonths       Int?     @map("useful_life_months")
  decliningRateBp        Int?     @map("declining_rate_bp")
  businessShareBp        Int      @default(10000) @map("business_share_bp")
  // The share used for study or employment: its depreciation goes on the employment annex line below.
  annexShareBp           Int      @default(0) @map("annex_share_bp")
  annexLineKey           String?  @map("annex_line_key")
  reminderCents          Int      @default(0) @map("reminder_cents")
  openingYear            Int?     @map("opening_year")
  openingBookValueCents  Int?     @map("opening_book_value_cents")
  openingRemainingMonths Int?     @map("opening_remaining_months")
  disposalDate           String?  @map("disposal_date")
  disposalKind           String?  @map("disposal_kind")
  disposalProceedsCents  Int?     @map("disposal_proceeds_cents")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  parts TaxAssetPart[]

  @@index([authWorkspaceId])
  @@map("tax_assets")
}

// One receipt, or one line of a receipt, that is part of an asset's cost. Each
// belongs to at most one asset. `rowId` has no foreign key (see meal_guests.row_id); the row
// delete paths remove the link in code.
model TaxAssetPart {
  id              String   @id @default(uuid())
  authWorkspaceId String   @map("auth_workspace_id")
  authTenantId    String?  @map("auth_tenant_id")
  assetId         String   @map("asset_id")
  rowId           String   @map("row_id")
  // '' = the whole receipt; otherwise the id of one of its lines (TaxReceiptLine).
  // A string with a default rather than a nullable column, so the uniqueness holds.
  lineId          String   @default("") @map("line_id")
  createdAt       DateTime @default(now()) @map("created_at")

  asset TaxAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([rowId, lineId])
  @@index([assetId])
  @@map("tax_asset_parts")
}

// A change of the section 19 status from a day on (crossing a limit, or
// choosing regular taxation). The first answer stays in
// workspace_tax_settings.small_business and applies from the beginning; a
// receipt, an invoice or an asset is judged by the status on its own date, so
// a change never moves earlier figures. `effectiveFrom` is an ISO day.
model TaxStatusChange {
  id              String   @id @default(uuid())
  authWorkspaceId String   @map("auth_workspace_id")
  authTenantId    String?  @map("auth_tenant_id")
  effectiveFrom   String   @map("effective_from")
  smallBusiness   Boolean  @map("small_business")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([authWorkspaceId, effectiveFrom])
  @@map("tax_status_changes")
}

// An invoice the business issued: a list entry, not a document (no template,
// no numbering, no rendering; that tier is the Books plan's). It holds no
// client name: names of clients are personal data and belong to the contact
// store. Revenue counts on the days of its payments.
model TaxIssuedInvoice {
  id              String   @id @default(uuid())
  authWorkspaceId String   @map("auth_workspace_id")
  authTenantId    String?  @map("auth_tenant_id")
  number          String
  issueDate       String?  @map("issue_date")
  grossCents      Int      @map("gross_cents")
  vatCents        Int      @default(0) @map("vat_cents")
  treatment       String
  // For an invoice with more than one rate (treatment 'mixed'): [{ rateBp, netCents, vatCents }], one per rate.
  taxGroups       Json?    @map("tax_groups")
  declaredInYear  Int?     @map("declared_in_year")
  // Booked out as never to be paid (a fee the client deducted, a remainder not collectable); never income.
  writtenOffCents Int      @default(0) @map("written_off_cents")
  writtenOffOn    String?  @map("written_off_on")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  payments     TaxInvoicePayment[]
  paymentLinks TaxPaymentLink[]

  @@unique([authWorkspaceId, number])
  @@map("tax_issued_invoices")
}

// Money received for an issued invoice, with its day.
model TaxInvoicePayment {
  id              String   @id @default(uuid())
  authWorkspaceId String   @map("auth_workspace_id")
  authTenantId    String?  @map("auth_tenant_id")
  invoiceId       String   @map("invoice_id")
  paidOn          String   @map("paid_on")
  cents           Int
  createdAt       DateTime @default(now()) @map("created_at")

  invoice TaxIssuedInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("tax_invoice_payments")
}

// A payment of value-added tax to the tax office ('paid') or a refund from it
// ('refunded'). Under the cash-basis statement both are lines of their own.
model TaxVatSettlement {
  id              String   @id @default(uuid())
  authWorkspaceId String   @map("auth_workspace_id")
  authTenantId    String?  @map("auth_tenant_id")
  settledOn       String   @map("settled_on")
  cents           Int
  direction       String
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([authWorkspaceId])
  @@map("tax_vat_settlements")
}

// The ten-day rule at the turn of the year (section 11 of the income tax act):
// a regularly recurring payment made between 22 December and 10 January counts
// for the year it belongs to, not the year it was paid in. A person answers per
// payment. `subjectKind` is 'receipt' (`subjectId` is the row id, no foreign
// key, see meal_guests.row_id) or 'vat_settlement'. `cashDay` is the payment
// day the answer was given for: when that day changes, the answer no longer
// applies and the question is asked again.
model TaxYearBoundaryAnswer {
  id                 String   @id @default(uuid())
  authWorkspaceId    String   @map("auth_workspace_id")
  authTenantId       String?  @map("auth_tenant_id")
  subjectKind        String   @map("subject_kind")
  subjectId          String   @map("subject_id")
  cashDay            String   @map("cash_day")
  belongsToOtherYear Boolean  @map("belongs_to_other_year")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([authWorkspaceId, subjectKind, subjectId])
  @@map("tax_year_boundary_answers")
}

// ── Income tax estimate ──────────────────────────────────────────────────────
//
// Facts of the person for the income tax estimate (finance plan, slice 6).
// Stored are only what a wage statement, a pay slip or the owner states; the
// estimate itself is computed on read (src/lib/tax/income-tax).

// The figures of an annual wage statement (`month` 0) or of the pay slip of
// one month (1 to 12), per year and employer. `employer` is a label the owner
// chooses. Amounts in cents. `churchLiable` is set on pay slips only: church
// tax due in that month (a church exit ends it within a year).
model TaxWageStatement {
  id                        String   @id @default(uuid())
  authWorkspaceId           String   @map("auth_workspace_id")
  authTenantId              String?  @map("auth_tenant_id")
  year                      Int
  employer                  String
  month                     Int
  grossCents                Int      @map("gross_cents")
  wageTaxCents              Int      @map("wage_tax_cents")
  solidarityCents           Int      @default(0) @map("solidarity_cents")
  churchTaxCents            Int      @default(0) @map("church_tax_cents")
  pensionEmployeeCents      Int      @default(0) @map("pension_employee_cents")
  pensionEmployerCents      Int      @default(0) @map("pension_employer_cents")
  healthEmployeeCents       Int      @default(0) @map("health_employee_cents")
  careEmployeeCents         Int      @default(0) @map("care_employee_cents")
  unemploymentEmployeeCents Int      @default(0) @map("unemployment_employee_cents")
  healthWithSickPay         Boolean  @default(true) @map("health_with_sick_pay")
  churchLiable              Boolean? @map("church_liable")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  @@unique([authWorkspaceId, year, employer, month])
  @@map("tax_wage_statements")
}

// Another item of the income tax return of a year, by rule key
// (src/lib/tax/income-tax/return-items.ts): an amount, or days (and a
// distance for a commute), with an optional note on the evidence.
model TaxReturnItem {
  id              String   @id @default(uuid())
  authWorkspaceId String   @map("auth_workspace_id")
  authTenantId    String?  @map("auth_tenant_id")
  year            Int
  key             String
  amountCents     Int?     @map("amount_cents")
  days            Int?
  distanceKm      Int?     @map("distance_km")
  ownCar          Boolean  @default(false) @map("own_car")
  note            String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([authWorkspaceId, year])
  @@map("tax_return_items")
}

// Per year: the months church tax was due, twelve characters '1' or '0'
// starting with January (NULL: not stated), and the day the return was filed.
model TaxYearSettings {
  id              String   @id @default(uuid())
  authWorkspaceId String   @map("auth_workspace_id")
  authTenantId    String?  @map("auth_tenant_id")
  year            Int
  churchMonths    String?  @map("church_months")
  // The day the income tax return of the year was filed ("2026-10-17"); null while open. A filed
  // year fixes its payments at the turn of the year the way they were filed (src/lib/tax/year-boundary.ts).
  filedOn         String?  @map("filed_on")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([authWorkspaceId, year])
  @@map("tax_year_settings")
}

// ── Payments ─────────────────────────────────────────────────────────────────
//
// Booked movements on the owner's accounts, imported from export files (and
// later from the bank interface). A payment is evidence: it gives a receipt or
// an invoice its real day and euro amount once the two are linked. No full
// account number is stored anywhere.

// One of the owner's accounts (a bank account, a card, a payment service).
model TaxAccount {
  id              String   @id @default(uuid())
  authWorkspaceId String   @map("auth_workspace_id")
  authTenantId    String?  @map("auth_tenant_id")
  label           String
  kind            String
  // True when the owner said the whole account is private: its payments are
  // not asked about. A single payment can still be linked to a receipt by hand
  // (a business expense paid privately) or re-labelled.
  isPrivate       Boolean  @default(false) @map("is_private")
  createdAt       DateTime @default(now()) @map("created_at")

  batches        TaxImportBatch[]
  payments       TaxPayment[]
  bankConnection TaxBankConnection?
  share          TaxAccountShare?

  @@unique([authWorkspaceId, label])
  @@map("tax_accounts")
}

// One imported file. `contentHash` (SHA-256 of the file) refuses the same file
// twice for the same account; overlapping files are deduplicated per payment.
model TaxImportBatch {
  id              String   @id @default(uuid())
  authWorkspaceId String   @map("auth_workspace_id")
  authTenantId    String?  @map("auth_tenant_id")
  accountId       String   @map("account_id")
  contentHash     String   @map("content_hash")
  format          String
  paymentCount    Int      @map("payment_count")
  newCount        Int      @map("new_count")
  firstDay        String?  @map("first_day")
  lastDay         String?  @map("last_day")
  // The payment service whose movements an import of the bank interface holds
  // ('paypal' when the connection's institution is PayPal), else NULL. Kept on
  // the import, so the account stays recognized as that service after the
  // connection ends (see `heldService` in src/lib/tax/payments/funding.ts).
  service         String?
  // Days of its range on which this import knowingly lacks a movement (a fetch
  // that left one out: no reference rate, or described too incompletely). An
  // import of another source compares them like its edge days, so the movement
  // can still arrive from a file (see `importPayments`).
  partialDays     String[] @default([]) @map("partial_days")
  createdAt       DateTime @default(now()) @map("created_at")

  account   TaxAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  payments  TaxPayment[]
  cancelled TaxPayment[] @relation("cancelledBy")

  @@unique([accountId, contentHash])
  @@map("tax_import_batches")
}

// One booked movement. `amountCents` is signed (negative: money out).
// `sourceHash` is its identity within the account across files.
// `sourceKind` is what the file says it is; `kindOverride` what a person says.
// `counterpartyKey` is the normalized name the counterparty rules match on.
model TaxPayment {
  id                  String   @id @default(uuid())
  authWorkspaceId     String   @map("auth_workspace_id")
  authTenantId        String?  @map("auth_tenant_id")
  accountId           String   @map("account_id")
  batchId             String   @map("batch_id")
  bookingDay          String   @map("booking_day")
  valueDay            String?  @map("value_day")
  amountCents         Int      @map("amount_cents")
  counterparty        String
  counterpartyKey     String   @map("counterparty_key")
  reference           String
  entryReference      String?  @map("entry_reference")
  sourceKind          String   @map("source_kind")
  kindOverride        String?  @map("kind_override")
  sourceHash          String   @map("source_hash")
  // A movement in another currency (the PayPal live feed): what the source
  // states, in that currency's cents, and the currency. `amountCents` is then
  // the euro amount at the reference rate of the booking day and
  // `amountEstimated` is true, until a file supplies the real euro amount.
  originalAmountCents Int?     @map("original_amount_cents")
  originalCurrency    String?  @map("original_currency")
  amountEstimated     Boolean  @default(false) @map("amount_estimated")
  // PayPal's list: the code of the purchase a currency conversion row belongs
  // to ("Zugehöriger Transaktionscode"), so the live feed's row of that
  // purchase is recognized by its code. Not part of the identity.
  relatedReference    String?  @map("related_reference")
  // Set when a later import of the same source listed this purchase as
  // cancelled or refunded in full: the payment is kept for the record and
  // counts nowhere. Undoing that import sets it back to NULL (the foreign key
  // does), so the payment and its links count again.
  cancelledByBatchId  String?  @map("cancelled_by_batch_id")
  createdAt           DateTime @default(now()) @map("created_at")

  account     TaxAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  batch       TaxImportBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  cancelledBy TaxImportBatch?  @relation("cancelledBy", fields: [cancelledByBatchId], references: [id], onDelete: SetNull)
  links       TaxPaymentLink[]

  @@unique([accountId, sourceHash])
  @@index([authWorkspaceId, bookingDay])
  @@map("tax_payments")
}

// How a counterparty is treated, asked once: 'business' (its payments need a
// document), 'private' (ignored for the business), or 'own_account' (moving
// money between the owner's own accounts).
model TaxCounterpartyRule {
  id              String   @id @default(uuid())
  authWorkspaceId String   @map("auth_workspace_id")
  authTenantId    String?  @map("auth_tenant_id")
  counterpartyKey String   @map("counterparty_key")
  label           String
  treatment       String
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([authWorkspaceId, counterpartyKey])
  @@map("tax_counterparty_rules")
}

// A payment (or part of it) that belongs to a receipt row or to an issued
// invoice; exactly one of `rowId` and `invoiceId` is set. `cents` is positive.
// `method` says how the link came about: 'reference' (the document's number is
// in the payment's text), 'manual' (a person picked it) or 'estimate' (a
// person accepted the proposal for a receipt on an estimated amount). `rowId`
// has no foreign key (see meal_guests.row_id); the row delete paths remove the link.
model TaxPaymentLink {
  id              String   @id @default(uuid())
  authWorkspaceId String   @map("auth_workspace_id")
  authTenantId    String?  @map("auth_tenant_id")
  paymentId       String   @map("payment_id")
  rowId           String?  @map("row_id")
  invoiceId       String?  @map("invoice_id")
  cents           Int
  method          String
  createdAt       DateTime @default(now()) @map("created_at")

  payment TaxPayment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice TaxIssuedInvoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([rowId])
  @@index([invoiceId])
  // Every read of a company's payments reads its own links by this column (payments across companies, 0035).
  @@index([authWorkspaceId])
  @@map("tax_payment_links")
}

// One position of a receipt, when a receipt was split because its positions
// are treated differently (one business, one private; one an asset, one not).
// `grossCents` and `netCents` are in the receipt's own currency. The lines of
// a receipt must add up to its total; that is checked on read, because the
// receipt can be corrected later. `allocations` NULL: the line is treated like
// its receipt (decision, vendor rule or defaults); otherwise the line has a
// decision of its own. `rowId` has no foreign key (see meal_guests.row_id).
model TaxReceiptLine {
  id                String   @id @default(uuid())
  authWorkspaceId   String   @map("auth_workspace_id")
  authTenantId      String?  @map("auth_tenant_id")
  rowId             String   @map("row_id")
  position          Int      @default(0)
  description       String
  grossCents        Int      @map("gross_cents")
  netCents          Int?     @map("net_cents")
  allocations       Json?
  formLineKey       String?  @map("form_line_key")
  employmentLineKey String?  @map("employment_line_key")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([authWorkspaceId, rowId])
  @@map("tax_receipt_lines")
}

// What still needs a person's eye on ONE receipt, and what a person has
// already settled about it.
//
// `flags` are the doubts the reader recorded when it read the receipt (a total
// it could not confirm, a failed classification). `checkedAt` is a person
// saying "I looked, it is right", which hides those flags until the receipt is
// read again. `distinctFrom` lists the receipts a person confirmed are NOT the
// same purchase, so a look-alike warning is settled once and does not come
// back. Facts that can be seen on the row itself (no amount, no date) are not
// stored here: they are worked out on read and end when the row is completed.
//
// `rowId` has no foreign key for the same reason as meal_guests.row_id; the
// row delete paths remove the review in code.
model ReceiptReview {
  rowId           String    @id @map("row_id")
  authWorkspaceId String    @map("auth_workspace_id")
  authTenantId    String?   @map("auth_tenant_id")
  flags           String[]  @default([])
  distinctFrom    String[]  @default([]) @map("distinct_from")
  checkedAt       DateTime? @map("checked_at")
  // The total the reader read when it recorded `flags`, in cents. A stored
  // total that differs from it was corrected since: a doubt about the total ends.
  readGrossCents  Int?      @map("read_gross_cents")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([authWorkspaceId])
  @@map("receipt_reviews")
}

// ── Private spending ─────────────────────────────────────────────────────────
//
// Plan docs/plans/2026-10-14-personal-spending-and-bank-feed.md. Like the
// finance tables, only what a person SAID is stored; every sum is computed on
// read from the payments.

// The spending category a person gave a counterparty (one of the twelve keys
// in src/lib/spending/categories.ts). It applies to every payment of that
// counterparty in the workspace, past and future, and is taken back by deleting it.
model SpendingCategoryAnswer {
  id              String   @id @default(uuid())
  authWorkspaceId String   @map("auth_workspace_id")
  authTenantId    String?  @map("auth_tenant_id")
  counterpartyKey String   @map("counterparty_key")
  label           String
  category        String
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([authWorkspaceId, counterpartyKey])
  @@map("spending_category_answers")
}

// A person saying "no receipt exists for this payment", with the reason. The
// only thing the missing-receipt loop stores about a payment: every other state
// (linked, needs none, a receipt fits, missing) is worked out on read
// (src/lib/spending/loop.ts). `paymentId` has no foreign key on purpose: an
// undone import takes the payment away and the answer simply stops applying;
// should the same movement come back, its id is new and it is asked about again.
model SpendingReceiptAnswer {
  id              String   @id @default(uuid())
  authWorkspaceId String   @map("auth_workspace_id")
  authTenantId    String?  @map("auth_tenant_id")
  paymentId       String   @map("payment_id")
  reason          String
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([authWorkspaceId, paymentId])
  @@map("spending_receipt_answers")
}

// How the owner wants to be told (src/lib/spending/notify/port.ts): 'push'
// (then e-mail as the fallback), 'email' or 'in_app'. No row: push.
model SpendingSettings {
  id              String   @id @default(uuid())
  authWorkspaceId String   @unique @map("auth_workspace_id")
  authTenantId    String?  @map("auth_tenant_id")
  channel         String   @default("push")
  notifyEmail     String?  @map("notify_email")
  // The owner's own names (src/lib/spending/own-names.ts): a counterparty carrying one is an own account.
  ownNames        String[] @default([]) @map("own_names")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("spending_settings")
}

// The in-app queue of notifications, and the record of their delivery.
// `subjectKey` makes a notification happen at most once per workspace
// ("missing_receipt:<payment id>"). `channel` is the channel that delivered
// it, NULL when it is in the app only; `attempts` says what each channel
// answered. A delivery that failed is tried again on a later run until
// `tries` reaches the limit; one that was merely unavailable is not.
model SpendingNotification {
  id              String    @id @default(uuid())
  authWorkspaceId String    @map("auth_workspace_id")
  authTenantId    String?   @map("auth_tenant_id")
  subjectKey      String    @map("subject_key")
  kind            String
  title           String
  body            String
  path            String
  channel         String?
  attempts        String[]  @default([])
  failed          Boolean   @default(false)
  tries           Int       @default(0)
  readAt          DateTime? @map("read_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([authWorkspaceId, subjectKey])
  @@index([authWorkspaceId, readAt])
  // A subject names its payment: whether a payment was announced is looked up across companies (payments across companies, 0035).
  @@index([subjectKey])
  @@map("spending_notifications")
}

// A monthly budget the owner set himself (src/lib/spending/budgets.ts):
// `scope` 'category' (key: a category key) or 'vendor' (key: a counterparty
// key). `limitCents` NULL switches the budget off. No row for a category: its
// limit is the average of the last twelve full months, computed on read.
model SpendingBudget {
  id              String   @id @default(uuid())
  authWorkspaceId String   @map("auth_workspace_id")
  authTenantId    String?  @map("auth_tenant_id")
  scope           String
  key             String
  label           String
  limitCents      Int?     @map("limit_cents")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([authWorkspaceId, scope, key])
  @@map("spending_budgets")
}

// Step 3 of the missing-receipt loop: the mailbox was searched for the
// invoice of one payment. `tries` counts the searches (an invoice mail can
// arrive days after the payment, so a search that found nothing is repeated a
// few times), `outcome` is 'found', 'none' or 'error'. `paymentId` has no
// foreign key for the same reason as spending_receipt_answers.payment_id.
model SpendingMailSearch {
  id              String   @id @default(uuid())
  authWorkspaceId String   @map("auth_workspace_id")
  authTenantId    String?  @map("auth_tenant_id")
  paymentId       String   @map("payment_id")
  outcome         String
  tries           Int      @default(0)
  searchedAt      DateTime @map("searched_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([authWorkspaceId, paymentId])
  @@map("spending_mail_searches")
}

// One attachment of one mail that may be a payment's invoice: where to find
// it again in the mailbox (the message and the attachment's place and name),
// never its content. The owner takes it into the normal upload path from the
// spending page, or sets it aside as not the invoice.
model SpendingMailCandidate {
  id              String    @id @default(uuid())
  authWorkspaceId String    @map("auth_workspace_id")
  authTenantId    String?   @map("auth_tenant_id")
  paymentId       String    @map("payment_id")
  messageId       String    @map("message_id")
  partIndex       Int       @map("part_index")
  fileName        String    @map("file_name")
  mimeType        String    @map("mime_type")
  receivedDay     String    @map("received_day")
  subject         String
  sender          String
  // Set when the owner said "not the invoice": never offered again, kept so a new search does not bring it back.
  dismissedAt     DateTime? @map("dismissed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@unique([authWorkspaceId, paymentId, messageId, partIndex])
  @@index([authWorkspaceId, paymentId])
  @@map("spending_mail_candidates")
}

// A phone (or browser) that asked for push notifications for this workspace:
// the push service's address for it and its two public keys
// (src/lib/spending/notify/push.ts), and the person who switched it on.
// `renewedAt` is set each time that person opens the spending page with push
// on: a device not renewed for 30 days gets nothing more, so a person who
// lost access (removed from the company, signed out for good) stops getting
// its messages. A device the push service reports gone (404 or 410) is
// deleted; `failures` counts failed sends in a row, and at ten the device is
// deleted too.
model SpendingPushSubscription {
  id              String    @id @default(uuid())
  authWorkspaceId String    @map("auth_workspace_id")
  authTenantId    String?   @map("auth_tenant_id")
  userId          String    @map("user_id")
  endpoint        String
  p256dh          String
  auth            String
  failures        Int       @default(0)
  lastSuccessAt   DateTime? @map("last_success_at")
  renewedAt       DateTime  @default(now()) @map("renewed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([authWorkspaceId, endpoint])
  @@index([endpoint])
  @@map("spending_push_subscriptions")
}

// Which invoice a receipt refers to: a credit note (`kind` "credit_note") and
// the invoice it corrects, by the number the credit note names and, where one
// stored receipt carries that number, that receipt. `rowId` and
// `referencedRowId` have no foreign key, as meal_guests.row_id; the row delete
// paths remove the reference in code.
model ReceiptReference {
  rowId                   String   @id @map("row_id")
  authWorkspaceId         String   @map("auth_workspace_id")
  authTenantId            String?  @map("auth_tenant_id")
  kind                    String
  referencedInvoiceNumber String?  @map("referenced_invoice_number")
  referencedRowId         String?  @map("referenced_row_id")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@index([authWorkspaceId])
  @@index([referencedRowId])
  @@map("receipt_references")
}

// The live bank connection of one account (Enable Banking, plan 2026-10-07,
// "Reality: the live bank connection"). One per account. The movements it
// fetches go into TaxPayment through the normal import; nothing of the bank's
// data is kept here except the masked choices of a session (`candidates`).
// `sessionId` is stored on purpose: without the application's private key,
// which lives only in Infisical, it opens nothing.
// `stateHash` is the SHA-256 of the random state of a consent in progress,
// cleared when the bank's answer is taken, so the answer cannot be replayed.
model TaxBankConnection {
  id                  String    @id @default(uuid())
  authWorkspaceId     String    @map("auth_workspace_id")
  authTenantId        String?   @map("auth_tenant_id")
  accountId           String    @unique @map("account_id")
  aspspName           String    @map("aspsp_name")
  aspspCountry        String    @map("aspsp_country")
  // The institution a consent in progress asks (a renewal may change it); taken over when it succeeds.
  pendingAspspName    String?   @map("pending_aspsp_name")
  pendingAspspCountry String?   @map("pending_aspsp_country")
  // 'pending' | 'choose_account' | 'active' | 'expired' | 'revoked' | 'error'
  status              String
  stateHash           String?   @map("state_hash")
  stateExpiresAt      DateTime? @map("state_expires_at")
  sessionId           String?   @map("session_id")
  accountUid          String?   @map("account_uid")
  // [{ uid, mask, name, currency }]: the accounts of the session, masked; kept after the choice for a renewal.
  candidates          Json?
  // The masked number and name of the bank account this connection reads, to find it again in a renewed session.
  boundMask           String?   @map("bound_mask")
  boundName           String?   @map("bound_name")
  validUntil          DateTime? @map("valid_until")
  lastSyncedAt        DateTime? @map("last_synced_at")
  // The last booked day fetched; the next fetch starts five days before it.
  lastBookedThrough   String?   @map("last_booked_through")
  // A code, never bank data.
  lastError           String?   @map("last_error")
  lastErrorAt         DateTime? @map("last_error_at")
  // What a person has to look at and clears himself, so the next clean fetch
  // never wipes it: `gaps` (days no fetch can reach any more, after a renewal
  // that came later than the 89 days the bank looks back) and `skipped` (days
  // with a movement the bank described too incompletely to import). See
  // `BankNotices` in src/lib/tax/payments/bank/service.ts.
  notices             Json?
  // The last day a successful fetch reached, whatever was booked: a gap is
  // only what lies between it and the 89 days the bank still gives.
  fetchedThrough      String?   @map("fetched_through")
  // When a fetch was last tried, whatever came of it: the daily run starts with
  // the connection tried longest ago, so a bank failing every day never keeps
  // the others waiting.
  lastAttemptedAt     DateTime? @map("last_attempted_at")
  // When the bank account now read was bound: only imports from then on are
  // this account's own when a reworded booking is matched.
  boundAt             DateTime? @map("bound_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  account TaxAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([authWorkspaceId])
  @@index([stateHash])
  @@index([status])
  @@map("tax_bank_connections")
}

// The private payments of one account go to another company of the same
// person (plan docs/plans/2026-10-22-payments-across-companies.md). The row is
// the holder's (`authWorkspaceId`, `authTenantId`: the company the account
// belongs to); `receiverWorkspaceId` and `receiverTenantId` name the company
// that gets the payments the holder's answers call private. Nothing is copied:
// which payment goes where is worked out on read (src/lib/tax/payments/route.ts).
// One receiver per account. Deleting the row ends the share; the payments are
// back with the holder at once.
model TaxAccountShare {
  id                  String   @id @default(uuid())
  authWorkspaceId     String   @map("auth_workspace_id")
  authTenantId        String?  @map("auth_tenant_id")
  accountId           String   @unique @map("account_id")
  receiverWorkspaceId String   @map("receiver_workspace_id")
  receiverTenantId    String?  @map("receiver_tenant_id")
  // The person who linked the two companies (an auth-brain user id), for the record.
  createdByUserId     String   @map("created_by_user_id")
  createdAt           DateTime @default(now()) @map("created_at")

  account TaxAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([authWorkspaceId])
  @@index([receiverWorkspaceId])
  @@map("tax_account_shares")
}

// The time of the last accepted call of the daily bank fetch
// (/api/internal/bank-sync), one row. Stored in the database so a signed call
// runs once also across a restart and with more than one app instance.
model TaxBankSyncGuard {
  id     String @id
  lastTs BigInt @map("last_ts")

  @@map("tax_bank_sync_guard")
}
