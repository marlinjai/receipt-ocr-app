# ============================================================
# Receipt OCR App — Environment Variables
# Mount via 1Password Environments as .env.local (dev) or .env (prod)
# ============================================================

# Database (Postgres)
DATABASE_URL=postgres://receipts:password@postgres:5432/receipts

# Storage Brain (file uploads to R2)
NEXT_PUBLIC_STORAGE_BRAIN_URL=https://storage-brain-api.marlin-pohl.workers.dev
STORAGE_BRAIN_API_KEY=

# Google Cloud Vision (OCR text extraction)
GOOGLE_CLOUD_VISION_API_KEY=

# OpenRouter (AI classification — category, Konto, Zuordnung)
OPENROUTER_API_KEY=

# Google Sheets importer (per-user OAuth to read the user's own sheets).
# Separate OAuth client from auth-brain login; scope: spreadsheets.readonly.
# Redirect URI: https://receipts.lumitra.co/api/google/oauth/callback (+ localhost for dev).
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
# 32-byte key sealing the stored Google refresh token (AES-256-GCM).
# Generate with: openssl rand -hex 32
SHEETS_TOKEN_ENC_KEY=

# Kill switch for the service worker: set to 1 and restart to make every browser
# unregister it on its next page load (see src/lib/pwa/service-worker.ts).
DISABLE_SERVICE_WORKER=

# Spending notifications by e-mail (the fallback when push is not possible).
# Off until all three are set. RESEND_API_KEY lives in Infisical; the sender
# must be on a domain verified at Resend; APP_BASE_URL is where mail links go.
RESEND_API_KEY=
SPENDING_MAIL_FROM=
APP_BASE_URL=

# Step 3 of the missing-receipt loop: the expenses mailbox, read-only (Gmail
# interface, scope gmail.readonly). Off until all five are set; the values
# live in Infisical (see README, "Ausgaben-Postfach"). The workspace id names
# the one company the mailbox belongs to.
SPENDING_MAILBOX_CLIENT_ID=
SPENDING_MAILBOX_CLIENT_SECRET=
SPENDING_MAILBOX_REFRESH_TOKEN=
SPENDING_MAILBOX_ADDRESS=
SPENDING_MAILBOX_WORKSPACE_ID=
