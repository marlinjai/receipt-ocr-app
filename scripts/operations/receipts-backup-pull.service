[Unit]
Description=Copy receipts database recovery points off the production server
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/receipts-backup-pull
User=root
UMask=0077
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/receipts-backups /run/lock
ProtectHome=read-only
